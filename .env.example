# Public site origin — canonical i og:url. Bez ovoga se koristi Vercel domena deploymenta.
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by the booking server action (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox (account.mapbox.com → Access tokens). Without it the map falls back to an OSM iframe.
NEXT_PUBLIC_MAPBOX_TOKEN=


